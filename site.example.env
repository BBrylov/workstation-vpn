# workstation-vpn site config.
# Copy to ~/.config/workstation-vpn/site.env (chmod 600) and fill in. Never commit the filled-in file.

# SSH login to the AmneziaWG server. Needs root: install/uninstall add/remove this machine's peer.
SERVER_SSH=root@203.0.113.10
# Optional SSH key (otherwise your ssh config/agent is used).
SSH_KEY=~/.ssh/id_ed25519
# Server interface; its config must be /etc/amnezia/amneziawg/<SERVER_IF>.conf (awg-quick style).
SERVER_IF=awg0
# Address the client connects to.
SERVER_ENDPOINT=203.0.113.10:51820

# Local tunnel name: interface and unit awg-quick@<VPN_NAME>.
VPN_NAME=awgvpn
# Short text on the tray icon (up to 4 characters).
VPN_LABEL=VPN
# Optional: public IP expected after switching on (checked via ifconfig.me). Empty = just show the IP.
EXPECT_IP=203.0.113.10
# Optional: peer comment on the server. Default: hostname.
CLIENT_NAME=
# Optional: what goes into the tunnel. Default: everything (0.0.0.0/0).
ALLOWED_IPS=0.0.0.0/0
# Optional: keepalive seconds. Default: 25.
KEEPALIVE=25
